# Node 24 / Seenode
APP_ORIGIN=http://localhost:3000
# Leave empty in development, or provide an absolute path.
DATABASE_PATH=
ADMIN_EMAILS=gabolaurav@gmail.com
# Generate a 32-byte base64url token. Used only to activate the first admin.
# Never commit the real value. Admin chooses their own password.
ADMIN_SETUP_TOKEN=
NODE_ENV=development
# Production: DATABASE_PATH=/data/voyconplan.sqlite, NODE_ENV=production.
# Set VINEXT_TRUSTED_HOSTS to the exact generated deployment hostname.
VINEXT_TRUSTED_HOSTS=
# Providers below still require implementation, not only keys:
DUFFEL_ACCESS_TOKEN=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
PLACES_API_KEY=
WEATHER_API_KEY=
REQUIREMENTS_API_KEY=
CURRENCY_API_KEY=
