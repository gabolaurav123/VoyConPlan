# Node 24 / Seenode web service
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# External PostgreSQL. Leave blank to use SQLite ONLY in local development.
# In production without this value the public demo works; saved data/auth return503.
DATABASE_URL=
# Certificate verification stays enabled by default. 'disable' is an explicit
# opt-out intended only for trusted local/private database connections.
DATABASE_SSL_MODE=verify-full
# Optional provider CA certificate, PEM text (actual newlines or escaped \n).
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
# Local development only: optional absolute SQLite path. Never used in production.
DATABASE_PATH=
ADMIN_EMAILS=gabolaurav@gmail.com
# Generate a 32-byte base64url token. Admin chooses their own password.
ADMIN_SETUP_TOKEN=
# Production: exact public hostname. No scheme, slash or wildcard.
VINEXT_TRUSTED_HOSTS=
# Providers below still require implementation, not only keys:
DUFFEL_ACCESS_TOKEN=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
PLACES_API_KEY=
WEATHER_API_KEY=
REQUIREMENTS_API_KEY=
CURRENCY_API_KEY=
OPENAI_API_KEY=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
EMAIL_API_KEY=
